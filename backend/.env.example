# Bartcash API and worker. Copy to `.env` and fill in the blanks.
# Never commit `.env`.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
# Public URL of this API (used in password-reset links).
API_BASE_URL=http://localhost:8000/api
# Web origins allowed by CORS, comma-separated (only needed for the web build;
# the mobile app sends no Origin).
CLIENT_URL=
# true: this process also runs the background jobs (valuation, Qloo taste,
# matching). Use true on a single-process host; locally you can instead run
# `npm run worker` in a second terminal.
RUN_WORKER=false

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/bartcash"

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Access token lifetime in seconds (default 900).
JWT_ACCESS_TTL=900

# ── Image storage (Cloudflare R2, S3-compatible) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public base URL images are served from (bucket public URL or custom domain).
AWS_URL=
AWS_DEFAULT_REGION=auto
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Automated valuation, brand extraction and Scout messages (Groq) ─────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# A vision-capable model (the valuation reads the listing's cover photo).
GROQ_MODEL=
# Requests per minute for THIS process. All processes sharing one key must
# add up to 25 or less (free tier: 30/min).
GROQ_RPM=20

# ── Email (SendLibs) ────────────────────────────────────────────────────────
SENDLIBS_API_KEY=
MAIL_FROM_NAME=Bartcash
MAIL_FROM_ADDRESS=

# ── Qloo taste intelligence ─────────────────────────────────────────────────
# false: every Qloo feature is off and the app behaves as before Qloo.
QLOO_ENABLED=false
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Requests per second for THIS process (all processes together: 4 or less).
QLOO_RPS=1
# Per-request timeout in ms (8000 recommended where the worker runs).
QLOO_TIMEOUT_MS=8000
# Remaining monthly calls at which background work stops / all calls stop.
QLOO_BUDGET_SOFT_STOP=1000
QLOO_BUDGET_HARD_STOP=200

# ── Matching (optional tuning) ──────────────────────────────────────────────
# Component weights; missing keys keep their default.
MATCH_WEIGHTS=wants=0.40,taste=0.30,reciprocal=0.20,owner=0.10
# Hours before stored matches are refreshed on read.
MATCH_STALE_HOURS=24
