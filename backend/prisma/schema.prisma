// ============================================================================
// Bartcash — Prisma schema (Express/Postgres)
// ============================================================================
// Source of truth: bartcash_phase3_modelling_design_v3 (v3.0, Oct 6 2026),
// Section 3 (models), Section 4 (relationships), Section 10.12 (changes to
// existing tables). 18 live models + 7 Qloo models (3.19 - 3.25) = 25.
//
// Conventions (Phase 3, Section 3.0):
//   - UUID PKs, app-generated via @default(uuid()), native uuid column.
//   - Enum-like columns are String (VARCHAR) validated with Zod. No Prisma
//     enums, no CHECK constraints. Allowed values are in /// comments.
//   - created_at / updated_at are Timestamp(6) (no timezone). Exceptions:
//     trade_offers, otp_codes, qloo_cache: created_at only;
//     transactions, rate_limit_attempts: none; qloo_usage: updated_at only.
//   - Money/values are Decimal(10,2), USD everywhere.
//   - Soft delete (deleted_at): users, items, trades, messages, ratings.
//     Comments are hard-deleted.
//   - Schema is applied with `prisma db push` (no migration history).
//
// Qloo models are additive. With QLOO_ENABLED=false they sit unused.
// ============================================================================

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Users (3.1)
// ----------------------------------------------------------------------------
model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  profilePhoto    String?   @map("profile_photo") @db.VarChar(500)
  bio             String?
  location        String?   @db.VarChar(255)
  averageRating   Decimal   @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalTrades     Int       @default(0) @map("total_trades")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(6)
  pushToken       String?   @map("push_token")
  /// [Planned, Qloo] Set when the taste profile is saved; used to mark
  /// taste_compatibilities rows stale (Phase 3, 10.12)
  tasteUpdatedAt  DateTime? @map("taste_updated_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(6)

  items                  Item[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  notifications          Notification[]
  messagesSent           Message[]            @relation("MessagesBySender")
  tradesAsProposer       Trade[]              @relation("TradesAsProposer")
  tradesAsReceiver       Trade[]              @relation("TradesAsReceiver")
  tradesCancelled        Trade[]              @relation("TradesCancelledBy")
  tradesCurrentOffer     Trade[]              @relation("TradesCurrentOfferBy")
  tradesAwaitingResponse Trade[]              @relation("TradesAwaitingResponseFrom")
  tradeItemsOffered      TradeItem[]          @relation("TradeItemsOfferedBy")
  tradeOffersMade        TradeOffer[]         @relation("TradeOffersOfferedBy")
  transactionsAsProposer Transaction[]        @relation("TransactionsAsProposer")
  transactionsAsReceiver Transaction[]        @relation("TransactionsAsReceiver")
  ratingsGiven           Rating[]             @relation("RatingsAsRater")
  ratingsReceived        Rating[]             @relation("RatingsAsRated")
  disputesRaised         Dispute[]            @relation("DisputesRaisedBy")
  comments               Comment[]

  // [Planned, Qloo]
  tasteEntities               UserTasteEntity[]
  tasteCompatibilitiesAsUserA TasteCompatibility[] @relation("TasteCompatibilityUserA")
  tasteCompatibilitiesAsUserB TasteCompatibility[] @relation("TasteCompatibilityUserB")

  @@map("users")
}

// ----------------------------------------------------------------------------
// RefreshTokens (3.2)
// ----------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hash of the 128-character hex token
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([token, revoked], map: "idx_refresh_tokens_token_revoked")
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// PasswordResetTokens (3.3)
// ----------------------------------------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hash of the 64-character hex token
  token     String    @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// OtpCodes (3.4) — email verification codes. created_at only.
// ----------------------------------------------------------------------------
model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  /// bcrypt hash of the 6-digit code
  codeHash  String   @map("code_hash") @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([email], map: "idx_otp_codes_email")
  @@map("otp_codes")
}

// ----------------------------------------------------------------------------
// RateLimitAttempts (3.5) — fixed-window limiter for auth endpoints.
// Key prefixes: login:, forgot-password:, resend-otp-limit:
// ----------------------------------------------------------------------------
model RateLimitAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamp(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)

  @@map("rate_limit_attempts")
}

// ----------------------------------------------------------------------------
// Categories (3.6)
// Seeded by prisma/seed.ts (upsert on slug). Planned: 14 -> 9 by renaming 4
// and setting is_active=false on 5 (data change only, Phase 3 10.5).
// Inactive categories are hidden and cannot be used for new items.
// ----------------------------------------------------------------------------
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  icon      String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  items Item[]

  // [Planned, Qloo]
  itemWants ItemWant[]

  @@map("categories")
}

// ----------------------------------------------------------------------------
// Items (3.7)
// "Listing" appears only in comments.listing_id and UI language — same table.
// ----------------------------------------------------------------------------
model Item {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  categoryId   String    @map("category_id") @db.Uuid
  title        String    @db.VarChar(255)
  description  String    @db.Text
  /// One of: new, good, fair, poor
  condition    String    @db.VarChar(20)
  /// Optional note shown to other traders. With Qloo, matching uses
  /// item_wants instead (this is only a small keyword bonus).
  desiredTrade String?   @map("desired_trade") @db.Text
  /// One of: draft, available, in_trade, traded, inactive.
  /// The API creates items as draft; the column default is not used by it.
  status       String    @default("available") @db.VarChar(20)
  /// Immutable after creation
  isService    Boolean   @default(false) @map("is_service")
  location     String?   @db.VarChar(255)
  /// Single USD value declared by the owner at publish time. NOT a range.
  /// Shown beside, never merged with, the AI estimate.
  userDeclaredValue Decimal? @map("user_declared_value") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)

  user                       User           @relation(fields: [userId], references: [id])
  category                   Category       @relation(fields: [categoryId], references: [id])
  images                     ItemImage[]
  valuation                  ItemValuation?
  tradeItems                 TradeItem[]
  comments                   Comment[]
  transactionsAsReceiverItem Transaction[]

  // [Planned, Qloo]
  taste               ItemTaste?
  wants               ItemWant[]
  matchesAsSource     MatchResult[] @relation("MatchResultSourceItem")
  matchesAsCandidate  MatchResult[] @relation("MatchResultCandidateItem")

  @@index([userId], map: "idx_items_user_id")
  @@index([categoryId], map: "idx_items_category_id")
  @@map("items")
}

// ----------------------------------------------------------------------------
// ItemImages (3.8) — max six per item; first uploaded is primary.
// ----------------------------------------------------------------------------
model ItemImage {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  url          String   @db.VarChar(500)
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId], map: "idx_item_images_item_id")
  @@map("item_images")
}

// ----------------------------------------------------------------------------
// ItemValuations (3.9) — 1:1 with Item.
// ----------------------------------------------------------------------------
model ItemValuation {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @unique @map("item_id") @db.Uuid
  valueMin     Decimal? @map("value_min") @db.Decimal(10, 2)
  valueMax     Decimal? @map("value_max") @db.Decimal(10, 2)
  currency     String   @default("USD") @db.VarChar(3)
  /// Bucketed from the model score: high (80+), medium (50-79), low (<50).
  /// Null after a manual override.
  confidence   String?  @db.VarChar(20)
  /// Full provider response, for auditing. Never returned by the API.
  rawResponse  Json?    @map("raw_response")
  apiModel     String?  @map("api_model") @db.VarChar(100)
  /// One of: pending, completed, failed
  status       String   @default("pending") @db.VarChar(20)
  failedReason String?  @map("failed_reason") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId], map: "idx_item_valuations_item_id")
  @@map("item_valuations")
}

// ----------------------------------------------------------------------------
// Trades (3.10)
// ----------------------------------------------------------------------------
model Trade {
  id                   String    @id @default(uuid()) @db.Uuid
  proposerId           String    @map("proposer_id") @db.Uuid
  receiverId           String    @map("receiver_id") @db.Uuid
  /// One of: item, cash. An "item" trade may carry an optional top_up_amount.
  tradeType            String    @map("trade_type") @db.VarChar(20)
  /// One of: negotiating, accepted, declined, completed, disputed, cancelled.
  /// "pending" is legacy and no longer written. A timed-out round goes
  /// straight to declined (lazy expiry).
  status               String    @db.VarChar(20)
  /// Author of the live offer
  currentOfferBy       String?   @map("current_offer_by") @db.Uuid
  /// The user whose turn it is to accept, decline or counter
  awaitingResponseFrom String?   @map("awaiting_response_from") @db.Uuid
  /// Start of the current 3-hour round; checked lazily on read/act
  roundStartedAt       DateTime? @map("round_started_at") @db.Timestamp(6)
  /// One of: meetup, delivery. Set on acceptance.
  completionMethod     String?   @map("completion_method") @db.VarChar(20)
  meetupDetails        String?   @map("meetup_details") @db.Text
  deliveryDetails      String?   @map("delivery_details") @db.Text
  proposerConfirmed    Boolean   @default(false) @map("proposer_confirmed")
  receiverConfirmed    Boolean   @default(false) @map("receiver_confirmed")
  completedAt          DateTime? @map("completed_at") @db.Timestamp(6)
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelledBy          String?   @map("cancelled_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamp(6)

  proposer                 User         @relation("TradesAsProposer", fields: [proposerId], references: [id])
  receiver                 User         @relation("TradesAsReceiver", fields: [receiverId], references: [id])
  cancelledByUser          User?        @relation("TradesCancelledBy", fields: [cancelledBy], references: [id])
  currentOfferByUser       User?        @relation("TradesCurrentOfferBy", fields: [currentOfferBy], references: [id])
  awaitingResponseFromUser User?        @relation("TradesAwaitingResponseFrom", fields: [awaitingResponseFrom], references: [id])
  tradeItems               TradeItem[]
  tradeOffers              TradeOffer[]
  transaction              Transaction?
  messages                 Message[]
  ratings                  Rating[]
  dispute                  Dispute?

  @@index([awaitingResponseFrom])
  @@index([proposerId], map: "idx_trades_proposer_id")
  @@index([receiverId], map: "idx_trades_receiver_id")
  @@index([cancelledBy], map: "idx_trades_cancelled_by")
  @@map("trades")
}

// ----------------------------------------------------------------------------
// TradeItems (3.11) — one row per item per side; rewritten on counter-offer.
// ----------------------------------------------------------------------------
model TradeItem {
  id        String   @id @default(uuid()) @db.Uuid
  tradeId   String   @map("trade_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  offeredBy String   @map("offered_by") @db.Uuid
  /// One of: proposer, receiver
  side      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  trade         Trade @relation(fields: [tradeId], references: [id])
  item          Item  @relation(fields: [itemId], references: [id])
  offeredByUser User  @relation("TradeItemsOfferedBy", fields: [offeredBy], references: [id])

  @@index([tradeId], map: "idx_trade_items_trade_id")
  @@index([itemId], map: "idx_trade_items_item_id")
  @@map("trade_items")
}

// ----------------------------------------------------------------------------
// TradeOffers (3.12) — negotiation history, one row per offer. created_at only.
// No round_number/status/expires_at: round = count of rows; timer lives on
// trades.round_started_at.
// ----------------------------------------------------------------------------
model TradeOffer {
  id             String   @id @default(uuid()) @db.Uuid
  tradeId        String   @map("trade_id") @db.Uuid
  offeredBy      String   @map("offered_by") @db.Uuid
  /// Defined: item, cash, item_cash. The implementation writes only item and cash.
  tradeType      String   @map("trade_type") @db.VarChar(50)
  cashAmount     Decimal? @map("cash_amount") @db.Decimal(10, 2)
  topUpAmount    Decimal? @map("top_up_amount") @db.Decimal(10, 2)
  /// Array of item UUIDs on the offering side — application-level reference, not an FK
  offeredItemIds Json     @map("offered_item_ids")
  isCurrent      Boolean  @default(true) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  trade         Trade @relation(fields: [tradeId], references: [id])
  offeredByUser User  @relation("TradeOffersOfferedBy", fields: [offeredBy], references: [id])

  @@index([tradeId])
  @@index([offeredBy])
  @@map("trade_offers")
}

// ----------------------------------------------------------------------------
// Transactions (3.13) — terms snapshot, created on accept. No timestamps
// besides agreed_at / completed_at.
// ----------------------------------------------------------------------------
model Transaction {
  id                String    @id @default(uuid()) @db.Uuid
  tradeId           String    @unique @map("trade_id") @db.Uuid
  /// Copied from the trade
  tradeType         String    @map("trade_type") @db.VarChar(50)
  proposerId        String    @map("proposer_id") @db.Uuid
  receiverId        String    @map("receiver_id") @db.Uuid
  receiverItemId    String?   @map("receiver_item_id") @db.Uuid
  /// Proposer items at acceptance — application-level reference, not an FK
  offeredItemIds    Json      @map("offered_item_ids")
  agreedCashAmount  Decimal?  @map("agreed_cash_amount") @db.Decimal(10, 2)
  agreedTopUpAmount Decimal?  @map("agreed_top_up_amount") @db.Decimal(10, 2)
  /// One of: pending_completion, completed. A disputed trade leaves the
  /// transaction at pending_completion.
  status            String    @db.VarChar(30)
  agreedAt          DateTime? @map("agreed_at") @db.Timestamp(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamp(6)

  trade        Trade @relation(fields: [tradeId], references: [id])
  proposer     User  @relation("TransactionsAsProposer", fields: [proposerId], references: [id])
  receiver     User  @relation("TransactionsAsReceiver", fields: [receiverId], references: [id])
  receiverItem Item? @relation(fields: [receiverItemId], references: [id])

  @@index([proposerId])
  @@index([receiverId])
  @@index([receiverItemId])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// Messages (3.14)
// ----------------------------------------------------------------------------
model Message {
  id        String    @id @default(uuid()) @db.Uuid
  tradeId   String    @map("trade_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String    @db.Text
  readAt    DateTime? @map("read_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  trade  Trade @relation(fields: [tradeId], references: [id])
  sender User  @relation("MessagesBySender", fields: [senderId], references: [id])

  @@index([tradeId], map: "idx_messages_trade_id")
  @@index([senderId], map: "idx_messages_sender_id")
  @@map("messages")
}

// ----------------------------------------------------------------------------
// Comments (3.15) — public per-listing enquiries. Hard delete, no deleted_at.
// ----------------------------------------------------------------------------
model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  listing Item @relation(fields: [listingId], references: [id])
  user    User @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@map("comments")
}

// ----------------------------------------------------------------------------
// Ratings (3.16)
// ----------------------------------------------------------------------------
model Rating {
  id        String    @id @default(uuid()) @db.Uuid
  tradeId   String    @map("trade_id") @db.Uuid
  raterId   String    @map("rater_id") @db.Uuid
  ratedId   String    @map("rated_id") @db.Uuid
  /// 1-5, validated in the API (no CHECK constraint)
  score     Int       @db.SmallInt
  review    String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  trade Trade @relation(fields: [tradeId], references: [id])
  rater User  @relation("RatingsAsRater", fields: [raterId], references: [id])
  rated User  @relation("RatingsAsRated", fields: [ratedId], references: [id])

  @@unique([tradeId, raterId])
  @@index([tradeId], map: "idx_ratings_trade_id")
  @@index([raterId], map: "idx_ratings_rater_id")
  @@index([ratedId], map: "idx_ratings_rated_id")
  @@map("ratings")
}

// ----------------------------------------------------------------------------
// Disputes (3.17)
// ----------------------------------------------------------------------------
model Dispute {
  id              String    @id @default(uuid()) @db.Uuid
  tradeId         String    @unique @map("trade_id") @db.Uuid
  raisedBy        String    @map("raised_by") @db.Uuid
  reason          String    @db.Text
  /// One of: open, under_review, resolved, closed. Only open is set by the API.
  status          String    @default("open") @db.VarChar(20)
  /// Reserved for post-MVP resolution
  resolutionNotes String?   @map("resolution_notes") @db.Text
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  trade        Trade @relation(fields: [tradeId], references: [id])
  raisedByUser User  @relation("DisputesRaisedBy", fields: [raisedBy], references: [id])

  @@index([tradeId], map: "idx_disputes_trade_id")
  @@index([raisedBy], map: "idx_disputes_raised_by")
  @@map("disputes")
}

// ----------------------------------------------------------------------------
// Notifications (3.18)
// ----------------------------------------------------------------------------
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// One of: trade_request, trade_rebargain, trade_accepted, trade_declined,
  /// trade_cancelled, trade_completed, trade_pending, dispute_raised,
  /// new_message (declared but never sent)
  type          String    @db.VarChar(30)
  title         String    @db.VarChar(255)
  body          String    @db.Text
  /// Polymorphic pointer — intentionally not a Prisma relation
  referenceId   String?   @map("reference_id") @db.Uuid
  /// Trade or Dispute
  referenceType String?   @map("reference_type") @db.VarChar(50)
  readAt        DateTime? @map("read_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}

// ============================================================================
// QLOO TASTE INTELLIGENCE — PLANNED (Phase 3 v3.0, Sections 3.19 - 3.25, 10)
// Additive. Unused while QLOO_ENABLED=false.
// ============================================================================

// ----------------------------------------------------------------------------
// ItemTastes (3.19) — one row per item; written by the item-taste job.
// ----------------------------------------------------------------------------
model ItemTaste {
  id               String    @id @default(uuid()) @db.Uuid
  itemId           String    @unique @map("item_id") @db.Uuid
  /// One of: pending, resolved, unresolved, failed
  status           String    @default("pending") @db.VarChar(20)
  qlooEntityId     String?   @map("qloo_entity_id") @db.VarChar(100)
  qlooEntityName   String?   @map("qloo_entity_name") @db.VarChar(255)
  /// Bartcash entity type, e.g. brand
  qlooEntityType   String?   @map("qloo_entity_type") @db.VarChar(20)
  /// One of: brand_extracted, title_search, none
  resolutionSource String?   @map("resolution_source") @db.VarChar(30)
  /// 0.00 to 1.00. Entities below 0.60 are discarded.
  confidence       Decimal?  @db.Decimal(3, 2)
  /// [{ tag_id, name }]
  tags             Json?
  /// Top 20: [{ entity_id, name, affinity, tag_ids }]
  relatedEntities  Json?     @map("related_entities")
  /// Exactly five when ready: [{ category_id, rank, reason }]
  wantSuggestions  Json?     @map("want_suggestions")
  /// One of: qloo, fallback
  suggestionSource String?   @map("suggestion_source") @db.VarChar(20)
  failedReason     String?   @map("failed_reason") @db.Text
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  item Item @relation(fields: [itemId], references: [id])

  @@map("item_tastes")
}

// ----------------------------------------------------------------------------
// ItemWants (3.20) — 1 to 3 ranked wanted categories per item (max enforced
// in the service layer).
// ----------------------------------------------------------------------------
model ItemWant {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  /// 1 to 3; 1 is most wanted
  rank         Int      @db.SmallInt
  /// True when the category was among the five suggested when it was picked
  wasSuggested Boolean  @default(false) @map("was_suggested")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  item     Item     @relation(fields: [itemId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([itemId, categoryId])
  @@unique([itemId, rank])
  @@index([itemId], map: "idx_item_wants_item_id")
  @@index([categoryId], map: "idx_item_wants_category_id")
  @@map("item_wants")
}

// ----------------------------------------------------------------------------
// UserTasteEntities (3.21) — taste profile interests. Max 25 per user
// (service layer); profile is active at 3+ rows. Cascades on user delete.
// ----------------------------------------------------------------------------
model UserTasteEntity {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  qlooEntityId String   @map("qloo_entity_id") @db.VarChar(100)
  name         String   @db.VarChar(255)
  /// One of: brand, artist, movie, tv_show, videogame, book, podcast
  /// (videogame, not video_game)
  entityType   String   @map("entity_type") @db.VarChar(20)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  /// [{ tag_id, name }]
  tags         Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, qlooEntityId])
  @@index([userId], map: "idx_user_taste_user_id")
  @@index([qlooEntityId], map: "idx_user_taste_entity_id")
  @@map("user_taste_entities")
}

// ----------------------------------------------------------------------------
// TasteCompatibilities (3.22) — one row per pair, user_a_id < user_b_id
// (string comparison, enforced in the service layer). Cascades on user delete.
// ----------------------------------------------------------------------------
model TasteCompatibility {
  id             String   @id @default(uuid()) @db.Uuid
  userAId        String   @map("user_a_id") @db.Uuid
  userBId        String   @map("user_b_id") @db.Uuid
  /// 0 to 1
  score          Decimal  @db.Decimal(4, 3)
  /// local_overlap (the only method in use)
  method         String   @db.VarChar(30)
  /// [{ qloo_entity_id, name, entity_type }] recorded by both users
  sharedEntities Json     @map("shared_entities")
  /// [{ tag_id, name }] common to both profiles
  sharedTags     Json?    @map("shared_tags")
  /// Set when either profile changes; cleared on recompute
  stale          Boolean  @default(false)
  computedAt     DateTime @map("computed_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  userA User @relation("TasteCompatibilityUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("TasteCompatibilityUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId], map: "idx_taste_compat_user_a")
  @@index([userBId], map: "idx_taste_compat_user_b")
  @@map("taste_compatibilities")
}

// ----------------------------------------------------------------------------
// MatchResults (3.23) — cached ranked matches, max 50 per source item.
// Cascades when either item is deleted.
// ----------------------------------------------------------------------------
model MatchResult {
  id                 String   @id @default(uuid()) @db.Uuid
  sourceItemId       String   @map("source_item_id") @db.Uuid
  candidateItemId    String   @map("candidate_item_id") @db.Uuid
  /// 1 is the best match for the source item
  rank               Int
  /// Combined score, 0 to 1
  score              Decimal  @db.Decimal(4, 3)
  /// Component W
  wantsFit           Decimal? @map("wants_fit") @db.Decimal(4, 3)
  /// Component T, normalised within the candidate set; null when Qloo
  /// was unavailable or the candidate has no entity
  tasteAffinity      Decimal? @map("taste_affinity") @db.Decimal(4, 3)
  /// Component R
  reciprocalFit      Decimal? @map("reciprocal_fit") @db.Decimal(4, 3)
  /// Component O; null when either profile is inactive
  ownerCompatibility Decimal? @map("owner_compatibility") @db.Decimal(4, 3)
  /// 1 in a wanted category, 2 in an unpicked suggested category, 3 any other available item
  poolTier           Int      @map("pool_tier") @db.SmallInt
  /// qloo (T present) or fallback (T absent)
  source             String   @db.VarChar(20)
  reason             String?  @db.VarChar(255)
  /// Why-this-matches payload
  explanation        Json?
  computedAt         DateTime @map("computed_at") @db.Timestamp(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  sourceItem    Item @relation("MatchResultSourceItem", fields: [sourceItemId], references: [id], onDelete: Cascade)
  candidateItem Item @relation("MatchResultCandidateItem", fields: [candidateItemId], references: [id], onDelete: Cascade)

  @@unique([sourceItemId, candidateItemId])
  @@index([sourceItemId, rank], map: "idx_match_results_source_rank")
  @@index([candidateItemId], map: "idx_match_results_candidate")
  @@map("match_results")
}

// ----------------------------------------------------------------------------
// QlooCache (3.24) — DB-level cache of Qloo responses. created_at only.
// Search/tags: 7 days. Insights: 24 hours. Failed responses never cached.
// ----------------------------------------------------------------------------
model QlooCache {
  id        String   @id @default(uuid()) @db.Uuid
  /// Hash of the endpoint and the sorted parameter set
  cacheKey  String   @unique @map("cache_key") @db.VarChar(255)
  /// search, insights or tags
  endpoint  String   @db.VarChar(40)
  response  Json
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([expiresAt], map: "idx_qloo_cache_expires_at")
  @@map("qloo_cache")
}

// ----------------------------------------------------------------------------
// QlooUsage (3.25) — single-row table tracking the reported call budget.
// updated_at only.
// ----------------------------------------------------------------------------
model QlooUsage {
  id                String   @id @default(uuid()) @db.Uuid
  callsSinceStart   Int      @default(0) @map("calls_since_start")
  /// Last x-month-ratelimit-remaining header value
  remainingReported Int?     @map("remaining_reported")
  /// Last x-month-ratelimit-limit header value (10000 observed)
  limitReported     Int?     @map("limit_reported")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("qloo_usage")
}
